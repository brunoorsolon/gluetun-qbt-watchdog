## Gluetun control server API key
## Generate with: docker run --rm qmcgaw/gluetun genkey
GLUETUN_API_KEY=SECURE_GLUETUN_API_KEY_HERE

## qBittorrent authentication
## Preferred for qBittorrent 5.2.0+ / WebAPI 2.14.1+.
## Generate in qBittorrent: Preferences -> WebUI -> API Key -> Generate.
QBT_AUTH_MODE=auto
QBT_API_KEY=

## Legacy fallback / first-start password recovery
QBT_USER=admin
QBT_PASS=SECURE_QBT_PASSWORD_HERE

## Optional runtime tuning
# false: HTTP APIs only; remove the Docker socket mount and configure explicit API URLs.
# Disables Docker health inspection, container restarts, and temporary-password recovery.
DOCKER_ENABLED=true
CHECK_INTERVAL=60
# Confirmed missing-port checks; increase to 10 for a roughly nine-minute minimum.
PORT_MISS_THRESHOLD=3
# Seconds from first missing port; also the persistent API/auth/sync error alert deadline.
# Both the miss count and this elapsed-time threshold must pass before any restart.
MISSING_PORT_GRACE=300
# Seconds for Gluetun's own recovery and after each watchdog restart (fixed, non-sliding).
GLUETUN_RECOVERY_GRACE=300
# Minimum seconds between attempts, retained even after successful sync/manual reset.
RESTART_COOLDOWN=900
# Maximum VPN API stop/start attempts in one outage, including failed calls.
MAX_VPN_RESTARTS=2
# One final restart of Gluetun only; never restart/stop qBittorrent or other apps.
RESTART_GLUETUN_CONTAINER=true
HEARTBEAT_CYCLE_FREQUENCY=10

## Monitoring and persistence
# Match the port mapping if you publish this port outside the Docker network.
HEALTH_PORT=8081
# The Compose example mounts a persistent named volume at /state.
# Keep that volume across upgrades; it prevents repeated recovery attempts and alerts.
